{
  "name": "@shieldedtech/moth-extension",
  "version": "0.13.0",
  "private": true,
  "description": "Moth Wallet browser extension for the Midnight Network. USE AT YOUR OWN RISK. This is experimental software provided AS-IS with no warranty. Not audited. For development and testing purposes only.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .output .wxt",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.10",
