    "@scure/base": "2.2.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "typescript": "^5.5.0",
    "vite": "^7.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.1.0"
  }
}
