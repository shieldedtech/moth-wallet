{
  "name": "@shieldedtech/moth-mock-dapp",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone browser workbench for exercising the Midnight dApp connector API exposed by a wallet.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
