{
  "name": "@shieldedtech/moth-cli",
  "version": "0.12.1",
  "description": "CLI tool for Midnight Network wallet operations and contract deployments. USE AT YOUR OWN RISK. Experimental software provided AS-IS with no warranty. Not audited. For development and testing purposes only.",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shieldedtech/moth-wallet.git",
    "directory": "packages/cli"
  },
  "bin": {
    "moth": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./adapters/*": "./dist/adapters/*.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@oclif/core": "^4.2.0",
    "@shieldedtech/moth-tui": "^0.12.1",
    "@shieldedtech/moth-wallet": "^0.12.1",
    "dotenv": "17.4.2",
    "ink": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.5.0",
    "vitest": "^3.1.0"
  },
  "oclif": {
    "bin": "moth",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topicSeparator": " "
  }
}
