# Loaded by direnv when entering this directory.
# Opt-in: run `direnv allow` once after cloning. No effect without direnv installed.

# Enforce signed commits and tags locally. Branch protection enforces signed
# commits server-side; this catches missing signing keys at commit time, not
# push time.
git config --local commit.gpgSign true
git config --local tag.gpgSign true

# Auto-add Signed-off-by trailer for DCO compliance.
git config --local format.signOff true
