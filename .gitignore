# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env*
# ...but .envrc is ours: a direnv hook that turns on commit signing locally, so
# contributors find out at commit time rather than at push time. It carries no
# secrets. It survived in the old repository only because it was tracked before
# the .env* rule existed, and a fresh `git add` silently dropped it.
!.envrc
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Wallet data (never commit keys)
.midnight-wallet/
*.keystore

# Speckit / Claude tooling (local-only)
.claude/
.specify/
CLAUDE.md
.agents/
.midnight-expert/
.turbo/

# WXT (browser extension)
.output/
.wxt/

# design-sync (machine state, regenerated)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
packages/extension/.ds-css/

# Security scan output (local-only)
moth-wallet_VULNHUNT_RESULTS_2026-07-22-123723/

# Released extension zips, staged here for hand-off. Reproducible from a tagged
# checkout via `yarn build && yarn zip`, and ~12 MB each — committing them would
# put every release permanently in the history of a public repo.
extension-binary/

# Brand masters (multi-MB). Ship only the derived icons in packages/extension/public.
artwork/

# Security review output — findings and working exploits. Never commit.
*_VULNHUNT_RESULTS_*/
