    "PanelScreen": "components/moth/panel.tsx",
    "PanelHeader": "components/moth/panel.tsx",
    "Crescent": "components/moth/panel.tsx",
    "TokenIcon": "components/moth/token.tsx",
    "NoteCard": "components/moth/note-card.tsx",
    "StatusHero": "components/moth/status.tsx",
