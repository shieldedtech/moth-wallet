# Moth Wallet Configuration
# Copy to .env and modify as needed. Values here are overridden by CLI flags.

# Network endpoints
# MOTH_INDEXER_URL=http://localhost:8088
# MOTH_NODE_URL=ws://localhost:9944
# MOTH_PROVER=server
# MOTH_PROOF_SERVER_URL=http://localhost:6300

# Authentication (for CI/non-interactive use only)
# MOTH_PASSPHRASE=

# Headless consent arming. Required (together with --auto-approve and
# --max-spend) before `moth daemon serve` or `moth mcp` will serve spend
# operations with no human at the confirmation modal. Belt-and-suspenders
# with the flag: neither alone enables auto-approval.
# MOTH_DAEMON_AUTO_APPROVE=

# NOTE: Mnemonics are NOT accepted via environment variable (SR-001).
# For CI, pipe via stdin: echo "$MNEMONIC" | moth wallet import --name ci-wallet
# NOTE: `moth mcp` reads MOTH_PASSPHRASE from its own environment (set it in
# the MCP client's env block) — stdin is the protocol channel, so it cannot
# prompt, and the client controls the cwd so a .env file may not be found.
